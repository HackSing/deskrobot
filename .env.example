# 复制为 .env 再填。.env 不进仓库。
ROBOT_NAME=主持人
WEB_PORT=8766
DEFAULT_PROJECT=默认项目

# 大脑（OpenAI 兼容接口）。不填 LLM_KEY 就自动用假大脑。
LLM_URL=
LLM_KEY=
LLM_MODEL=
# 联网搜索的额外参数，JSON，按供应方文档填。例：{"enable_search": true}
LLM_SEARCH_EXTRA={}

# 语音
ASR_URL=
ASR_KEY=
TTS_URL=
TTS_KEY=

# 单独切换真假模块：1 = 假
# USE_FAKE_SPEECH=1
# USE_FAKE_ROBOT=1
# USE_FAKE_BRAIN=1

# 调参
OFF_TOPIC_EVERY=30
CONFIRM_WAIT=8
