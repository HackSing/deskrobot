# 复制为 .env 再填。.env 不进仓库。
ROBOT_NAME=小登
WEB_PORT=8766
DEFAULT_PROJECT=供应商报价

# 大脑（OpenAI 兼容接口）。不填 LLM_KEY 就自动用假大脑。
LLM_URL=
LLM_KEY=
LLM_MODEL=
# 联网搜索的额外参数，JSON，按供应方文档填。例：{"enable_search": true}
LLM_SEARCH_EXTRA={}
# 每次请求都并进请求体的额外参数，JSON。推理模型必须在这里关掉思考：
# 不关的话思考内容会把 max_tokens 吃光，content 返回空串、finish_reason=length。
LLM_EXTRA={"thinking":{"type":"disabled"},"max_tokens":400}

# 语音
ASR_URL=
ASR_KEY=
TTS_URL=
TTS_KEY=

# 单独切换真假模块：1 = 假
# USE_FAKE_SPEECH=1
# USE_FAKE_ROBOT=1
# USE_FAKE_BRAIN=1

# 演示模式：1 = 启动时预置会前准备和资料，大脑包一层 DemoBrain
DEMO_MODE=1
# 开场后每隔几秒往转写里灌一条预置的 mock 会议记录（只为让看板动起来）
MOCK_DRIP_SECONDS=4
# 非空：被提问后先说一句垫话，再去问 LLM
ASK_FILLER=我看一下。
# 非空：说"会议结束"后先固定回这句，再出纪要
END_TEXT=好的，会议结束。会议纪要马上推送到大家的手机。
# 0 = 不做逐条待办拍背确认，纪要直接落库
CONFIRM_TODOS=0
# 1 = 纪要改用真 LLM 生成；0 = 读 demo/mock_minutes.json
MINUTES_FROM_LLM=0

# H5 那边自建页面时：把每次快照变化 POST 到这个地址，空 = 不推送。
# 载荷固定 {"event": 事件名, "ts": 时间戳, "data": 快照}，字段映射在 core/push.py 的 adapt() 里改。
H5_PUSH_URL=
# 非空时请求带 Authorization: Bearer <token>
H5_PUSH_TOKEN=
# 单次推送超时，秒
H5_PUSH_TIMEOUT=3

# 调参
OFF_TOPIC_EVERY=30
CONFIRM_WAIT=8
